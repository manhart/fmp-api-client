{
    "name": "manhart/fmp-api-client",
    "description": "Typed PHP client for Financial Modeling Prep (FMP), supporting Stable endpoints and Legacy APIs",
    "keywords": [
        "api-client",
        "composer",
        "etf",
        "financial-data",
        "financial-modeling-prep",
        "fmp",
        "php",
        "stocks"
    ],
    "homepage": "https://github.com/manhart/fmp-api-client",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Manhart",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/manhart/fmp-api-client/issues",
        "source": "https://github.com/manhart/fmp-api-client"
    },
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-ctype": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Manhart\\Fmp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manhart\\Fmp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "generate": "php tools/generate.php"
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/vendor",
            "/.recordings",
            "/.phpunit.cache",
            "/.env",
            "/composer.lock"
        ]
    }
}
